# Server Port
PORT=5000

# AI Image Generation Provider Configuration
# Supported providers: "pollinations", "huggingface", "openai", "together", "stability"
# If no key is set, the application defaults to Pollinations AI (FLUX / SDXL engines) seamlessly!

# HuggingFace API Key (Optional)
# Get your token from https://huggingface.co/settings/tokens
HF_TOKEN=

# OpenAI API Key for DALL-E 3 (Optional)
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Together AI Key (Optional)
# Get your key from https://api.together.xyz/
TOGETHER_API_KEY=

# Stability AI Key (Optional)
# Get your key from https://platform.stability.ai/
STABILITY_API_KEY=
